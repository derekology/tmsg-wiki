---
const { hasSidebar } = Astro.locals.starlightRoute;
---

<wiki-page-frame>
	<header class="wiki-header"><slot name="header" /></header>
	{
		hasSidebar && (
			<dialog id="site-navigation" aria-labelledby="site-navigation-title">
				<div class="drawer-heading">
					<button type="button" data-close-menu aria-label="Close main navigation" autofocus>×</button>
				</div>
				<nav class="sidebar-content" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
					<slot name="sidebar" />
				</nav>
			</dialog>
		)
	}
	<div class="main-frame"><slot /></div>
</wiki-page-frame>

<script>
	class WikiPageFrame extends HTMLElement {
		connectedCallback() {
			const dialog = this.querySelector<HTMLDialogElement>('#site-navigation');
			const toggle = this.querySelector<HTMLButtonElement>('[data-open-menu]');
			if (!dialog || !toggle) return;

			toggle.addEventListener('click', () => {
				if (!dialog.open) dialog.showModal();
				toggle.setAttribute('aria-expanded', String(dialog.open));
			});
			this.querySelector('[data-close-menu]')?.addEventListener('click', () => dialog.close());
			dialog.addEventListener('close', () => toggle.setAttribute('aria-expanded', 'false'));
			dialog.addEventListener('click', (event) => {
				const bounds = dialog.getBoundingClientRect();
				const outside = event.clientX < bounds.left || event.clientX > bounds.right ||
					event.clientY < bounds.top || event.clientY > bounds.bottom;
				if (outside || (event.target instanceof Element && event.target.closest('a[href]'))) {
					dialog.close();
				}
			});
		}
	}
	customElements.define('wiki-page-frame', WikiPageFrame);
</script>

<style>
	wiki-page-frame {
		display: block;
		min-height: 100vh;
	}

	.wiki-header {
		position: fixed;
		inset: 0 0 auto;
		z-index: var(--sl-z-index-navbar);
		height: var(--sl-nav-height);
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		border-bottom: 1px solid var(--sl-color-hairline-shade);
		background: var(--sl-color-bg-nav);
	}

	.main-frame {
		padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
	}

	dialog {
		position: fixed;
		inset: 0 auto 0 0;
		margin: 0;
		width: min(20rem, 90vw);
		max-width: none;
		height: 100dvh;
		max-height: none;
		padding: 1rem;
		border: 0;
		border-right: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-text);
		background: var(--sl-color-bg-sidebar);
		overflow-y: auto;
		overscroll-behavior: contain;
		transform: translateX(-100%);
		transition: transform 180ms ease, display 180ms allow-discrete, overlay 180ms allow-discrete;
	}

	dialog[open] {
		transform: translateX(0);
	}

	dialog::backdrop {
		background: rgb(0 0 0 / 45%);
		opacity: 0;
		transition: opacity 180ms ease, display 180ms allow-discrete, overlay 180ms allow-discrete;
	}

	dialog[open]::backdrop {
		opacity: 1;
	}

	@starting-style {
		dialog[open] { transform: translateX(-100%); }
		dialog[open]::backdrop { opacity: 0; }
	}

	.drawer-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.drawer-heading h2 {
		font-size: 1rem;
		font-weight: 700;
	}

	.drawer-heading button {
		flex-shrink: 0;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 2px;
		font-size: 1.5rem;
		color: var(--sl-color-text);
		background: var(--sl-color-bg-nav);
		cursor: pointer;
	}

	.drawer-heading button:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 3px;
	}

	.sidebar-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (prefers-reduced-motion: reduce) {
		dialog, dialog::backdrop { transition: none; }
	}

	@media print {
		.wiki-header, dialog { display: none; }
		.main-frame { padding-top: 0; }
	}
</style>
