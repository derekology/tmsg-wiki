---
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-brand">
	{
		Astro.locals.starlightRoute.hasSidebar && (
			<button
				type="button"
				data-open-menu
				aria-label="Open main navigation"
				aria-controls="site-navigation"
				aria-haspopup="dialog"
				aria-expanded="false"
				class="site-menu-toggle print:hidden"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M3 6h18M3 12h18M3 18h18" />
				</svg>
			</button>
		)
	}
	<a href={siteTitleHref} class="site-title sl-flex">
		{
			config.logo && logos.dark && (
				<>
					<img
						class:list={{ 'light:sl-hidden print:hidden': !('src' in config.logo) }}
						alt=""
						src={logos.dark.src}
						width={logos.dark.width}
						height={logos.dark.height}
					/>
					{!('src' in config.logo) && (
						<img
							class="dark:sl-hidden print:block"
							alt=""
							src={logos.light?.src}
							width={logos.light?.width}
							height={logos.light?.height}
						/>
					)}
				</>
			)
		}
		<span class:list={{ 'sr-only': config.logo?.replacesTitle, 'site-title-text': true }} translate="no">
			<span class="site-title-line">THE <span class="site-title-red">MARKETING</span></span>
			<span class="site-title-line"><span class="site-title-red">SYSTEMS</span> WIKI</span>
		</span>
	</a>
</div>
